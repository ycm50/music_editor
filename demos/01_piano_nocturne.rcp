# ── 示例 01: 钢琴 · 夜曲 (C 大调, 4/4, 慢板 66) ───────────────────
# 演示: @voice 多声部 / 连音 _ / 附点 / 力度 !pp..!f / 和弦 [a+b]
#   @voice 1 = 右手旋律, @voice 2 = 左手伴奏
#   每个 @voice 独立时间轴, 纵向叠加; 每行严格 = 1 小节 (4 拍)

@ref C4
@bpm 66
@beat 0.909
@meter 4/4
@timbre piano

# ── 右手旋律 ──
@voice 1
5.+04!p 1.+04 2.+04 3.04
3.04 2.04 1.04 7.04
6.04 5.04 3.04 1.04
5.04 3.04 2.02

1.+04 2.+04 3.04 5.04
6.04 5.04 3.04 2.04
2.04 3.04 4.04 5.04
1.+04 7.04 6.02!p

3.04!mf 4.08 4.08 5.04 6.04
5.04 4.04 3.04 2.04
3.04 2.08 1.08 7.04 6.04
1.02 5.04 4.04

1.+04!f 2.+04 3.+04 2.+04
1.+04!mf 6.04 7.04 6.04
1.+04 2.+04 3.+02
1.+01!mp

# ── 左手伴奏 (根音 + 和弦, 用 _ 连音撑满时值) ──
@voice 2
1.-02   [1.-04+3.-04]_[1.-04+3.-04]
6.-02   [6.-04+1.04]_[6.-04+1.04]
4.-02   [4.-04+6.-04]_[4.-04+6.-04]
5.-04   [5.-04+7.-04]_[5.-04+7.-04]_[5.-04+7.-04]

1.-02   [1.-04+3.-04]_[1.-04+3.-04]
4.-02   [4.-04+6.-04]_[4.-04+6.-04]
2.-02   [2.-04+4.04]_[2.-04+4.04]
5.-04   [5.-04+7.-04]_[5.-04+7.-04]_[5.-04+7.-04]

1.-02   [1.-04+3.-04]_[1.-04+3.-04]
4.-02   [4.-04+6.-04]_[4.-04+6.-04]
2.-02   [2.-04+4.04]_[2.-04+4.04]
5.-04   [5.-04+7.-04]_[5.-04+7.-04]_[5.-04+7.-04]

1.-02   [1.-04+3.-04]_[1.-04+3.-04]
4.-02   [4.-04+6.-04]_[4.-04+6.-04]
1.-04   7.-04 6.-04 5.-04
[1.-01+3.-01+5.-01]
