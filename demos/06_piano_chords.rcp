# ── 示例 06: 练习曲 · 巴赫《C 大调前奏曲》和声型 (4/4, 72 BPM) ───
# 乐器: piano 钢琴
# 演示: 全曲由同一音型 (低音 + [和弦]_[和弦]) 构成, 和声进行 C-Am-F-G-C
#       这首最能检验"和弦是否能真正叠加": 最大同时发声应为 2~3
#       每行 = 1 小节 (4 拍), 共 16 小节

@ref C4
@bpm 72
@beat 0.833
@meter 4/4
@timbre piano

@voice 1
[1.02+3.02+5.02]_[1.02+3.02+5.02]
[1.02+3.02+5.02]_[1.02+3.02+5.02]
[6.02+1.+02+3.+02]_[6.02+1.+02+3.+02]
[6.02+1.+02+3.+02]_[6.02+1.+02+3.+02]
[4.02+6.02+1.+02]_[4.02+6.02+1.+02]
[4.02+6.02+1.+02]_[4.02+6.02+1.+02]
[5.02+7.02+2.+02]_[5.02+7.02+2.+02]
[5.02+7.02+2.+02]_[5.02+7.02+2.+02]
[1.02+3.02+5.02]_[1.02+3.02+5.02]
[6.02+1.+02+3.+02]_[6.02+1.+02+3.+02]
[4.02+6.02+1.+02]_[4.02+6.02+1.+02]
[2.02+4.02+7.02]_[2.02+4.02+7.02]
[5.02+7.02+2.+02]_[5.02+7.02+2.+02]
[1.02+3.02+5.02]_[1.02+3.02+5.02]
[4.02+6.02+1.+02]_[4.02+6.02+1.+02]
[1.02+3.02+5.02]_[1.02+3.02+5.02]

@voice 2
1.01
6.01
4.01
4.01
1.01
1.01
5.01
5.01
1.01
6.01
4.01
2.01
5.01
1.01
4.01
1.01
