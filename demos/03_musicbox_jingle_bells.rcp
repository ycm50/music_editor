# ── 示例 03: 圣诞 · Jingle Bells (C 大调, 4/4, 140 BPM) ───────────
# 乐器: music_box 八音盒 (起音 1ms + 明亮 0.86 → 清脆音梳感)
# 演示: !f / !mf / !p 力度对比, 大写八度跳进, 每行 1 小节 (4 拍)

@ref C4
@bpm 140
@beat 0.4286
@meter 4/4
@timbre music_box
@acoustic music_box noise=0.34;br=0.88

# ── 主旋律 ──
@voice 1
3.04!f 3.04 3.02
3.04 3.04 3.02
3.04 5.04 1.04 2.04
3.01
4.04 4.04 4.04 4.04
4.04 3.04 3.04 3.04
3.04 2.04 2.04 3.04
2.02 5.02

3.04!mf 3.04 3.02
3.04 3.04 3.02
3.04 5.04 1.04 2.04
3.01
4.04 4.04 4.04 4.04
4.04 3.04 3.04 3.04
5.04 5.04 4.04 2.04
1.01!p

# ── 低音伴奏 (和弦 + 单音, 每行 1 小节) ──
@voice 2
[1.01+3.01]
[5.01+7.01]
[1.01+3.01]
[1.02+3.02]_[1.02+3.02]
[4.01+6.01]
[1.01+3.01]
[5.01+7.01]
[5.01+7.01]

[1.01+3.01]
[5.01+7.01]
[1.01+3.01]
[1.02+3.02]_[1.02+3.02]
[4.01+6.01]
[1.01+3.01]
[5.01+7.01]
[1.01+3.01]
